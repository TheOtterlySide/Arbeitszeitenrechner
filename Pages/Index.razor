@page "/"
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IJSRuntime JsRuntime;
@inject IStringLocalizer<Index> L

<PageTitle>Arbeitszeitenrechner</PageTitle>
<div class="table-responsive">
    <table class="table table-borderless">
        <thead>
        <tr>
            <th class="col-lg-12">
                <div class="btn-group btn-group-toggle col-lg-12">
                    <div class="col-lg-1">
                        <button class="btn btn-primary" @onclick="() => ChangeLanguageToGerman()">Deutsch</button>
                    </div>
                    <div class="col-lg-1">
                        <button class="btn btn-primary" @onclick="() => ChangeLanguageToEnglisch()">English</button>
                    </div>
                    <div class="col-lg-1">
                        <button class="btn btn-primary" title="Design wechseln" @onclick="() => ToggleTheme()">
                            <i class=@_iconClass></i>
                        </button>
                    </div>
                </div>
            </th>
        </tr>
        </thead>
    </table>
</div>
<div class="table-responsive">
    <table class="table table-borderless">
        <thead>
        <tr>
            <th class="col-lg-6">
                <div>
                    <h1>@L["PauseTime"]</h1>
                </div>
            </th>
            <th class="col-lg-6">
                <div>
                    <h1>@L["WorkTime"]</h1>
                </div>
            </th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <th class="col-lg-6">
                <div class="btn-group btn-group-toggle col-lg-12" data-toggle="buttons">
                    <input type="radio" class="btn-check" name="btnradio" id="btnradio1" checked=@(IsCheckedPause(0)) autocomplete="off" @onclick=@(_ => SetPauseValue(0, null))>
                    <label class="btn btn-outline-primary" for="btnradio1">0 @L["Minutes"]</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" checked=@(IsCheckedPause(30)) @onclick=@(_ => SetPauseValue(30, null))>
                    <label class="btn btn-outline-primary" for="btnradio2">30 @L["Minutes"]</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off" checked=@(IsCheckedPause(45)) @onclick=@(_ => SetPauseValue(45, null))>
                    <label class="btn btn-outline-primary" for="btnradio3">45 @L["Minutes"]</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio4" autocomplete="off" @onclick=@(_ => SetCustomValueActive(0))>
                    <label class="btn btn-outline-primary" for="btnradio4">Custom</label>

                    @if (_showCustomPause)
                    {
                        <tr>
                            <th scope="row"></th>
                            <td>
                                <input type="number" class="form-control mx-2" @bind="_customPauseValue"/>
                            </td>
                        </tr>
                    }
                </div>
            </th>
            <th class="col-lg-6">
                <div class="btn-group btn-group-toggle col-lg-12" data-toggle="buttons">

                    <input type="radio" class="btn-check" name="btn-radio_Work" id="btn-radio_Work1" autocomplete="off" @onclick=@(_ => SetWorkValue(6, null))>
                    <label class="btn btn-outline-primary" for="btn-radio_Work1">6 @L["Hours"]</label>

                    <input type="radio" class="btn-check" name="btn-radio_Work" id="btn-radio_Work2" autocomplete="off" @onclick=@(_ => SetWorkValue(7, null))>
                    <label class="btn btn-outline-primary" for="btn-radio_Work2">7 @L["Hours"]</label>

                    <input type="radio" class="btn-check" name="btn-radio_Work" id="btn-radio_Work3" autocomplete="off" checked @onclick=@(_ => SetWorkValue(8, null))>
                    <label class="btn btn-outline-primary" for="btn-radio_Work3">8 @L["Hours"]</label>

                    <input type="radio" class="btn-check" name="btn-radio_Work" id="btn-radio_Work4" autocomplete="off" @onclick=@(_ => SetWorkValue(10, null))>
                    <label class="btn btn-outline-primary" for="btn-radio_Work4">10 @L["Hours"]</label>

                    <input type="radio" class="btn-check" name="btn-radio_Work" id="btn-radio_Work5" autocomplete="off" @onclick=@(_ => SetCustomValueActive(1))>
                    <label class="btn btn-outline-primary" for="btn-radio_Work5">Custom</label>

                    @if (_showCustomWork)
                    {
                        <tr>
                            <th scope="row"></th>
                            <td>
                                <input type="number" class="form-control mx-2" @bind="_customWorkValue"/>
                            </td>
                        </tr>
                    }
                </div>
            </th>
        </tr>
        </tbody>
    </table>
</div>
<br/>

<div class="table-responsive">
    <table class="table table-borderless">
        <thead>
        <tr>
            <th class="col-lg-6">
                <h1>@L["WorkStart"]</h1>
            </th>
            <th class="col-lg-6">
                <h1>@L["WorkEnd"]</h1>
            </th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <th class="col-lg-6">
                <div class="col-lg-12">
                    <input class="form-control" type="time" @bind="_starttime" @bind:event="oninput"/>
                </div>
            </th>
            <th class="col-lg-6">
                <div class="col-lg-12">
                    <input type="text" class="form-control" value="@_endtimeString" disabled>
                </div>
            </th>
        </tr>
        </tbody>
    </table>

    <div class="h-100 d-flex align-items-center justify-content-center">
        <h1>Countdown</h1>
    </div>
    <div class="h-100 d-flex flex-column align-items-center justify-content-center">
        @if (_running)
        {
            <h3 class="mb-3">@_timeleftAsString</h3>
            <h3>@L["WorkCooldown"] @_whenNextWorkTimeString </h3>
        }

        @if (_success)
        {
            <h3>@L["EndOfWork"]</h3>
        }

    </div>

    @if (_needPause)
    {
        <div class="h-100 d-flex align-items-center justify-content-center">
            <h3>@L["UntilPause"] @_needPauseValue</h3>
        </div>
    }
    <button class="btn btn-primary col-lg-12" data-toggle="button" @onclick=@(_ => CalculateTime(_workValue, _pauseValue))> @L["CalculateTime"]</button>
</div>

@code
{

    #region Timespan

    TimeSpan _pauseValue = new(0, 30, 0);
    TimeSpan _workValue = new(8, 0, 0);
    readonly TimeSpan _mustPause = new(hours: 6, 0, 0);
    static TimeSpan _timeleft;

    #endregion

    #region DateTime

    DateTime _starttime;
    DateTime _endtime;
    DateTime _whenNextWorkTime;
    DateTime _whenPause = new DateTime();

    #endregion

    private bool _germany;
    private bool _english;
    private bool _running;
    private bool _success = false;

    string _endtimeString = "00:00";
    string _needPauseValue = "00:00";
    readonly double _workCoolDown = 11;
    string _whenNextWorkTimeString = "00:00";
    bool _needPause;
    static string _timeleftAsString;
    string _iconClass = "bi bi-brightness-high-fill";

    bool _showCustomPause = false;
    bool _showCustomWork = false;
    int _customPauseValue;
    int _customWorkValue;

    Task? _timeTask = null;

    static bool _isActive;
    static bool _firstRendered;

    protected override async Task OnInitializedAsync()
    {
        var lDotNetReference = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("GLOBAL.SetDotnetReference", lDotNetReference);
        await JsRuntime.InvokeVoidAsync("isVisible");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _firstRendered = true;
            await JsRuntime.InvokeVoidAsync("initThemeToggle");
        }
    }

    private async Task ToggleTheme()
    {
        await JsRuntime.InvokeVoidAsync("themeManager.toggle");
        if (_iconClass == "bi bi-brightness-high-fill")
        {
            _iconClass = "bi bi-moon-stars";
        }
        else
        {
            _iconClass = "bi bi-brightness-high-fill";
        }
    }

    [JSInvokable("setTabActive")]
    public void SetActive(bool status)
    {
        if (_firstRendered)
        {
            _isActive = status;
            if (_isActive && _timeleftAsString != string.Empty && _running)
            {
                CalculateTime(_workValue, _pauseValue);
            }

            StateHasChanged();
        }
    }


    async Task Timer(CancellationToken ct)
    {
        _running = true;
        _timeleft = _endtime.Subtract(DateTime.Now);
        var sec = new TimeSpan(0, 0, 1);

        if (ct.IsCancellationRequested)
        {
            if (_timeleft <= new TimeSpan())
            {
                _running = false;
            }

            return;
        }

        while (_timeleft > new TimeSpan())
        {
            await Task.Delay(1000);
            _timeleft = _timeleft.Subtract(sec);
            _timeleftAsString = _timeleft.ToString("hh':'mm':'ss");
            ct.ThrowIfCancellationRequested();
            StateHasChanged();
        }


        _running = false;
        _success = true;
        StateHasChanged();
    }

    private void SetPauseValue(int val, int? id)
    {
        if (id != null) return;
        _showCustomPause = false;
        _pauseValue = new TimeSpan(0, val, 0);
        StateHasChanged();
    }


    private void SetWorkValue(int val, int? id)
    {
        if (id != null) return;
        _showCustomWork = false;
        _workValue = new TimeSpan(val, 0, 0);

        if (val >= 9)
        {
            SetPauseValue(45, null);
        }

        StateHasChanged();
    }

    private void SetCustomValueActive(int id)
    {
        if (id == 0)
        {
            //Show Custom Pause Input
            _showCustomPause = !_showCustomPause;
            StateHasChanged();
        }
        else
        {
            _showCustomWork = !_showCustomWork;
            StateHasChanged();
        }
    }

    void ChangeLanguageToEnglisch()
    {
        var selectedCulture = new CultureInfo("en");
        _germany = false;
        _english = true;
        CultureInfo.DefaultThreadCurrentCulture = selectedCulture;
        CultureInfo.DefaultThreadCurrentUICulture = selectedCulture;

        StateHasChanged();
    }

    void ChangeLanguageToGerman()
    {
        var selectedCulture = new CultureInfo("de");
        _germany = true;
        _english = false;
        CultureInfo.DefaultThreadCurrentCulture = selectedCulture;
        CultureInfo.DefaultThreadCurrentUICulture = selectedCulture;
        StateHasChanged();
    }

    void CalculateTime(TimeSpan hours, TimeSpan minutes)
    {
        CancellationTokenSource cts = new();

        if (_showCustomWork)
        {
            hours = new TimeSpan(_customWorkValue, 0, 0);
        }

        if (_showCustomPause)
        {
            minutes = new TimeSpan(0, _customPauseValue, 0);
        }

        _endtime = _starttime + DateTime.Today.TimeOfDay + hours + minutes;
        _whenPause = _starttime + _mustPause;

        if (_workValue > new TimeSpan(6, 0, 0))
        {
            _needPause = true;
            _needPauseValue = _whenPause.ToString("HH:mm");
        }

        _endtimeString = _endtime.ToString("t", CultureInfo.CurrentCulture);
        _whenNextWorkTime = _endtime.AddHours(_workCoolDown);
        _whenNextWorkTimeString = _whenNextWorkTime.ToString("t", CultureInfo.CurrentCulture);
        if (_timeTask != null)
        {
            cts.Cancel();
            cts.TryReset();
            _timeTask = Timer(cts.Token);
        }

        _timeTask = Timer(cts.Token);
    }

    private bool IsCheckedPause(int value)
    {
        var result = _pauseValue.Minutes == value;
        return result;
    }
}